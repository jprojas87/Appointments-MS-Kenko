# Copia este archivo a .env y ajusta los valores. .env NO se versiona.

# --- Entorno ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL 16, contenedor appointments-db) ---
# Usadas por docker-compose para crear la base de datos.
POSTGRES_DB=appointments
POSTGRES_USER=appointments
POSTGRES_PASSWORD=change-me-local-only
# Puerto en el host para conectarte a la BD con herramientas externas.
POSTGRES_HOST_PORT=5433
# Cadena que usa la API dentro de Docker (el host es el nombre del servicio).
# Si ejecutas uvicorn directamente en tu WSL, usa @localhost:5433 en su lugar.
DATABASE_URL=postgresql+psycopg://appointments:change-me-local-only@appointments-db:5432/appointments

# --- Puerto de la API en el host ---
API_HOST_PORT=8000

# --- AWS (se usará en la fase de eventos) ---
# Las credenciales NO van en este archivo: se toman de la cadena estándar de AWS
# (rol IAM en AWS real; perfil o variables de entorno en tu máquina de desarrollo).
AWS_REGION=us-east-1
EVENT_BUS_NAME=kenko-dev-bus

# --- JWT (lo emite Authentication; este servicio solo lo valida) ---
JWT_ALGORITHM=HS256
# Solo desarrollo con HS256. Obligatorio si JWT_ALGORITHM=HS256.
JWT_SECRET=change-me-dev-secret
# Clave pública PEM. Obligatoria si JWT_ALGORITHM=RS256.
JWT_PUBLIC_KEY=
# TODO: confirmar con el equipo de Authentication. Vacío = no se valida.
JWT_ISSUER=
JWT_AUDIENCE=

# --- Reglas de negocio ---
MIN_HOURS_BEFORE_CANCEL_OR_RESCHEDULE=24
MAX_DAYS_AHEAD_TO_SCHEDULE=90
